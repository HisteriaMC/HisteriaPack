{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
	  "description": {
		"identifier": "histeria:noctus",
		"materials": {
		  "default": "armor_stand"
		},
		"textures": {
		  "default": "textures/entity/custom_mobs/noctus"
		},
		"geometry": {
		  "default": "geometry.noctus"
		},
		"animations": {
		  "idle": "animation.noctus.idle",
		  "walk": "animation.noctus.walk",
		  "attack": "animation.noctus.attack"
		},
		"scripts": {
				"animate": [
				  {
					"attack": "variable.attack_time > 0.0"
				  },
				  {
					"idle": "query.modified_move_speed <= 0.01"
				  },
				  {
					"walk": "query.is_moving"
				  }
				]
			},
		"render_controllers": [
		  "controller.render.noctus"
		]
	  }
	}
  }