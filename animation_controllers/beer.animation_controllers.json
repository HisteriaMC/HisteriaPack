{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.beer.first_person_drink": {
      "initial_state": "first_person",
      "states": {
        "first_person": {
          "animations": [
            {
              "first_person_hold": "query.main_hand_item_use_duration <= 0.0"
            },
            {
              "first_person_drink": "query.main_hand_item_use_duration > 0.0"
            }
          ],
          "transitions": [
            {
              "third_person": "!c.is_first_person"
            }
          ]
        },
        "third_person": {
          "animations": [
            "third_person_hold"
          ],
          "transitions": [
            {
              "first_person": "c.is_first_person"
            }
          ]
        }
      }
    }
  }
}