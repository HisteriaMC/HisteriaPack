{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.beer.first_person_drink": {
      "initial_state": "hold",
      "states": {
        "hold": {
          "animations": [
            "hold"
          ],
          "transitions": [
            {
              "drink": "query.main_hand_item_use_duration>0.0"
            }
          ]
        },
        "drink": {
          "animations": [
            "drink_anim"
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "hold": "query.main_hand_item_use_duration<=0.0"
            }
          ]
        }
      }
    }
  }
}